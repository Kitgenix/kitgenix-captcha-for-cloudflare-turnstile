msgstr ""

#: includes/admin/class-settings-ui.php:1147
msgid "Development Mode (Warn-only)"
msgstr ""

#: includes/admin/class-settings-ui.php:1153
msgid "Enable warn-only mode (do not block submissions)."
msgstr ""

#: includes/admin/class-settings-ui.php:1156
msgid "Do not block submissions if Turnstile fails. Instead, log the failure and show an inline warning (admins only). Ideal for staging."
msgstr ""

#: includes/admin/class-settings-ui.php:1162
msgid "Test Mode (per integration)"
msgstr ""

#: includes/admin/class-settings-ui.php:1178
msgid "Warn-only for just the selected integrations, without turning off enforcement everywhere else. Useful for rolling out a new integration or diagnosing one flow without going site-wide warn-only. Ctrl/Cmd-click to select more than one."
msgstr ""

#: includes/admin/class-settings-ui.php:1191
msgid "Reliability"
msgstr ""

#: includes/admin/class-settings-ui.php:1199
msgid "Cloudflare outage failsafe"
msgstr ""

#: includes/admin/class-settings-ui.php:1206
msgid "If Cloudflare Turnstile becomes unreachable, let protected forms submit instead of blocking every visitor."
msgstr ""

#: includes/admin/class-settings-ui.php:1209
msgid "Off by default. When enabled, this plugin independently checks Cloudflare's own status (server-side, cached for 2 minutes) before bypassing verification 2.2.0 – 30 October 2026 a visitor cannot trigger this themselves by simply omitting a token. While active, an alert appears on this settings page and submissions are logged distinctly so you can tell a genuine Cloudflare-verified pass apart from a failsafe bypass. Leave this off if you would rather block submissions entirely during a Cloudflare outage."
msgstr ""

#: includes/admin/class-settings-ui.php:1230
msgid "Enable Replay Protection"
msgstr ""

#: includes/admin/class-settings-ui.php:1231
msgid "Rejects reused Turnstile tokens for a short period (default 10 minutes). Prevents replays and accidental double-submits."
msgstr ""

#: includes/admin/class-settings-ui.php:1243
msgid "Enable Honeypot Fallback Field"
msgstr ""

#: includes/admin/class-settings-ui.php:1244
msgid "Adds a hidden trap field alongside the widget on every integration. Real visitors never see or fill it; a bot that strips JavaScript and blindly fills every field gets blocked before Cloudflare is even contacted."
msgstr ""

#: includes/admin/class-settings-ui.php:1263
msgid "Account & Login Security"
msgstr ""

#: includes/admin/class-settings-ui.php:1271
msgid "Login Lockout"
msgstr ""

#: includes/admin/class-settings-ui.php:1272
msgid "Temporarily blocks further login attempts from an IP address or against a username after too many failures in a row (wrong password or failed Turnstile). Also rate-limits XML-RPC and Application Password logins, which use the same underlying check."
msgstr ""

#: includes/admin/class-settings-ui.php:1284
msgid "Max Failed Attempts"
msgstr ""

#: includes/admin/class-settings-ui.php:1285
msgid "Number of failures allowed (per IP and per username) before locking out further attempts."
msgstr ""

#: includes/admin/class-settings-ui.php:1293
msgid "Lockout Duration (minutes)"
msgstr ""

#: includes/admin/class-settings-ui.php:1294
msgid "How long an IP address or username stays locked out once the limit above is reached."
msgstr ""

#: includes/admin/class-settings-ui.php:1302
msgid "Disable XML-RPC"
msgstr ""

#: includes/admin/class-settings-ui.php:1303
msgid "Turns off the xmlrpc.php endpoint entirely. Leave this off if you use the Jetpack or WordPress mobile app, or another service that relies on XML-RPC 2.2.0 – 30 October 2026 Login Lockout above still rate-limits any login attempt that comes through it."
msgstr ""

#: includes/admin/class-settings-ui.php:1315
msgid "Block User Enumeration"
msgstr ""

#: includes/admin/class-settings-ui.php:1316
msgid "Blocks two common ways to discover valid usernames without logging in: the REST API's users list/endpoint, and the legacy \"?author=&lt;id&gt;\" link. Logged-in requests are never affected. Leave this off if you intentionally expose author pages or rely on the users REST route from a logged-out context (e.g. a headless frontend)."
msgstr ""

#: includes/admin/class-settings-ui.php:1335
msgid "Whitelist Settings"
msgstr ""

#: includes/admin/class-settings-ui.php:1343
msgid "Skip for Logged-in Users"
msgstr ""

#: includes/admin/class-settings-ui.php:1344
msgid "Useful for membership sites or intranets. Applies to all integrations."
msgstr ""

#: includes/admin/class-settings-ui.php:1355
msgid "IP Address Whitelist"
msgstr ""

#: includes/admin/class-settings-ui.php:1359
msgid "One per line. Supports exact IPs, wildcards (e.g. 203.0.113.*) and CIDR (e.g. 203.0.113.0/24, 2001:db8::/32)."
msgstr ""

#: includes/admin/class-settings-ui.php:1364
msgid "User Agent Whitelist"
msgstr ""

#: includes/admin/class-settings-ui.php:1368
msgid "One per line. Supports * wildcards. Matching agents skip loading the widget on page views (e.g. uptime monitors, crawlers). Because user agents can be spoofed, this never exempts a form submission from verification."
msgstr ""

#: includes/admin/class-settings-ui.php:1380
msgid "Reverse Proxy / Cloudflare"
msgstr ""

#: includes/admin/class-settings-ui.php:1388
msgid "Trust Cloudflare/Proxy Headers"
msgstr ""

#: includes/admin/class-settings-ui.php:1389
msgid "When enabled, the plugin will trust CF-Connecting-IP / X-Forwarded-For (etc.) only if the request comes from a trusted proxy below. Otherwise, REMOTE_ADDR is used."
msgstr ""

#: includes/admin/class-settings-ui.php:1400
msgid "Trusted Proxy IPs (one per line)"
msgstr ""

#: includes/admin/class-settings-ui.php:1405
msgid "Accepts IPv4/IPv6 or CIDR ranges, e.g. 203.0.113.10 or 2001:db8::/32. Only when REMOTE_ADDR matches one of these will proxy headers be used."
msgstr ""

